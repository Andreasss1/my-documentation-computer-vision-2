// ESP32 Code untuk kontrol 4 relay berdasarkan perintah dari PC

// Pin definitions untuk relay
const int RELAY_PIN_22 = 22;  // Relay 1 - untuk bubble detected
const int RELAY_PIN_18 = 18;  // Relay 2 - untuk bubble detected
const int RELAY_PIN_21 = 21;  // Relay 3 - ROI only
const int RELAY_PIN_19 = 19;  // Relay 4 - No ROI

void setup() {
  Serial.begin(9600);
  
  // Setup relay pins sebagai OUTPUT
  pinMode(RELAY_PIN_22, OUTPUT);
  pinMode(RELAY_PIN_18, OUTPUT);
  pinMode(RELAY_PIN_21, OUTPUT);
  pinMode(RELAY_PIN_19, OUTPUT);
  
  // Set semua relay OFF di awal (LOW = OFF untuk active HIGH relay)
  // Ganti ke HIGH jika menggunakan active LOW relay
  digitalWrite(RELAY_PIN_22, LOW);
  digitalWrite(RELAY_PIN_18, LOW);
  digitalWrite(RELAY_PIN_21, LOW);
  digitalWrite(RELAY_PIN_19, LOW);
  
  Serial.println("ESP32 Relay Control Ready");
}

void loop() {
  if (Serial.available() > 0) {
    String command = Serial.readStringUntil('\n');
    command.trim();
    
    if (command == "BUBBLE") {
      // Aktivasi relay pin 22 dan 18 (untuk bubble detected)
      digitalWrite(RELAY_PIN_22, HIGH);
      digitalWrite(RELAY_PIN_18, HIGH);
      digitalWrite(RELAY_PIN_21, LOW);
      digitalWrite(RELAY_PIN_19, LOW);
      Serial.println("Relay 22 & 18 ON - Bubble Detected");
      
    } else if (command == "ROI_ONLY") {
      // Aktivasi relay pin 21 (ROI detected, no bubble)
      digitalWrite(RELAY_PIN_22, LOW);
      digitalWrite(RELAY_PIN_18, LOW);
      digitalWrite(RELAY_PIN_21, HIGH);
      digitalWrite(RELAY_PIN_19, LOW);
      Serial.println("Relay 21 ON - ROI Only");
      
    } else if (command == "NO_ROI") {
      // Aktivasi relay pin 19 (No ROI detected)
      digitalWrite(RELAY_PIN_22, LOW);
      digitalWrite(RELAY_PIN_18, LOW);
      digitalWrite(RELAY_PIN_21, LOW);
      digitalWrite(RELAY_PIN_19, HIGH);
      Serial.println("Relay 19 ON - No ROI");
      
    } else if (command == "OFF") {
      // Matikan semua relay
      digitalWrite(RELAY_PIN_22, LOW);
      digitalWrite(RELAY_PIN_18, LOW);
      digitalWrite(RELAY_PIN_21, LOW);
      digitalWrite(RELAY_PIN_19, LOW);
      Serial.println("All Relays OFF");
    }
  }
}
